{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "automerge": true,
  "platformAutomerge": true,
  "rebaseWhen": "behind-base-branch",
  "postUpdateOptions": [
    "gomodTidy",
    "gomodUpdateImportPaths"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "github-actions"
      ],
      "pinDigests": true
    },
    {
      "matchManagers": [
        "gomod"
      ],
      "matchDepTypes": [
        "indirect"
      ],
      "enabled": true
    },
    {
      "matchManagers": [
        "gomod"
      ],
      "matchDepTypes": [
        "golang"
      ],
      "rangeStrategy": "bump"
    },
    {
      "description": "The custom manager updates GO_VERSION inside the interpolated Alpine tag",
      "matchManagers": [
        "dockerfile"
      ],
      "matchDepNames": [
        "golang"
      ],
      "enabled": false
    },
    {
      "matchDepNames": [
        "go",
        "golang"
      ],
      "groupName": "Go toolchain"
    },
    {
      "matchPackageNames": [
        "github.com/aws/aws-sdk-go-v2",
        "github.com/aws/aws-sdk-go-v2/**",
        "github.com/aws/smithy-go"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "AWS SDK for Go"
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "mariadb"
      ],
      "matchUpdateTypes": [
        "major",
        "minor"
      ],
      "enabled": false
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "mariadb"
      ],
      "matchCurrentVersion": "/^10[.]11[.]/",
      "groupName": "MariaDB 10.11"
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "mariadb"
      ],
      "matchCurrentVersion": "/^11[.]4[.]/",
      "groupName": "MariaDB 11.4"
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "mariadb"
      ],
      "matchCurrentVersion": "/^11[.]8[.]/",
      "groupName": "MariaDB 11.8"
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "mariadb"
      ],
      "matchCurrentVersion": "/^12[.]3[.]/",
      "groupName": "MariaDB 12.3"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/renovate\\.yml$/"
      ],
      "matchStrings": [
        "renovate-image: ghcr.io/renovatebot/renovate:(?<currentValue>[0-9]+)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "ghcr.io/renovatebot/renovate",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/verify\\.yml$/"
      ],
      "matchStrings": [
        "REGCTL_VERSION: (?<currentValue>v[0-9.]+)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "regclient/regclient"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^Dockerfile$/"
      ],
      "matchStrings": [
        "ARG GO_VERSION=(?<currentValue>[0-9.]+)"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "golang",
      "extractVersionTemplate": "^(?<version>[0-9]+[.][0-9]+)-alpine$",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^Dockerfile$/"
      ],
      "matchStrings": [
        "ARG ALPINE_VERSION=(?<currentValue>[0-9.]+)"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "alpine",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^tests/integration/docker_test[.]go$/"
      ],
      "matchStrings": [
        "defaultMariaDBTestImage = \"mariadb:(?<currentValue>[0-9.]+)@(?<currentDigest>sha256:[a-f0-9]{64})\""
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "mariadb",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^tests/integration/docker_test[.]go$/"
      ],
      "matchStrings": [
        "jcometki/minio:(?<currentValue>RELEASE[.][0-9TZ-]+-multiarch)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "jcometki/minio",
      "versioningTemplate": "regex:^RELEASE\\.(?<major>\\d{4})-(?<minor>\\d{2})-(?<patch>\\d{2})T(?<build>\\d{2})-(?<revision>\\d{2})-\\d{2}Z-multiarch$"
    }
  ]
}
