# Copy this template to .env before setting credentials.
# Database connection for docker run or the Go binary.
# docker-compose.yaml uses its own local development database connection.
MARIADB_HOST=mariadb
MARIADB_PORT=3306
MARIADB_USER=app_backup
MARIADB_PASSWORD=development-backup-password
MARIADB_SSL_CA=

# Choose DATABASE, DATABASES, or BACKUP_ALL=true (clear unused selectors).
# DATABASES takes precedence over DATABASE; BACKUP_ALL forbids both selectors.
MARIADB_DATABASE=app
MARIADB_DATABASES=
MARIADB_BACKUP_ALL=false
MARIADB_DATABASES_EXCLUDE=

# per-database creates one object per DB; combined creates one for all selected DBs.
BACKUP_MODE=per-database
MARIADB_DUMP_EXTRA_OPTS=

S3_REGION=us-west-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SESSION_TOKEN=
S3_BUCKET=
S3_PREFIX=backup
S3_ENDPOINT=
S3_ALLOW_HTTP=false
S3_UPLOAD_BUFFER=memory
S3_UPLOAD_PART_SIZE_MB=8

# Empty SCHEDULE runs once. cron expressions and @daily / @weekly are accepted.
SCHEDULE=
BACKUP_TIMEOUT=24h
# For MinIO and other custom endpoints, set expiration on the bucket itself.
BACKUP_KEEP_DAYS=
BACKUP_FILENAME_MODE=timestamp
BACKUP_ALLOW_UNVERSIONED_OVERWRITE=false
PASSPHRASE=

# Raw MariaDB restore diagnostics may include row values.
RESTORE_LOG_ERROR_DETAILS=false

# Per-database restore: source settings for older dumps with missing DB metadata.
# Example: {"app":{"character_set":"utf8mb4","collation":"utf8mb4_bin"}}
RESTORE_DATABASE_DEFAULTS=
