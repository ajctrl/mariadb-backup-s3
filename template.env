# Database connection for docker run or the Go binary.
# docker-compose.yaml uses its own local development database connection.
MARIADB_HOST=mariadb
MARIADB_PORT=3306
MARIADB_USER=root
MARIADB_PASSWORD=development-password
MARIADB_SSL_CA=

# Choose DATABASE, DATABASES, or BACKUP_ALL=true (clear unused selectors).
# DATABASES takes precedence over DATABASE; BACKUP_ALL forbids both selectors.
MARIADB_DATABASE=app
MARIADB_DATABASES=
MARIADB_BACKUP_ALL=false
MARIADB_DATABASES_EXCLUDE=

# per-database creates one object per DB; combined creates one for all selected DBs.
BACKUP_MODE=per-database
MARIADB_DUMP_EXTRA_OPTS=

S3_REGION=us-west-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SESSION_TOKEN=
S3_BUCKET=
S3_PREFIX=backup
S3_ENDPOINT=
# Per-object stream limit: part size * 10,000 MiB (8 = 78.125 GiB, 64 = 625 GiB).
# Measured after encryption; larger parts require more memory.
S3_UPLOAD_PART_SIZE_MB=8

# Empty SCHEDULE runs once. cron expressions and @daily / @weekly are accepted.
SCHEDULE=
# Deadline for the entire backup run (all databases, uploads and retention).
# Positive duration; increase for large backups. Does not apply to restore.
BACKUP_TIMEOUT=1h
BACKUP_KEEP_DAYS=
BACKUP_FILENAME_MODE=timestamp
PASSPHRASE=

# Restore only: source DB defaults for SQL dumps lacking complete metadata.
# JSON example: {"app":{"character_set":"utf8mb4","collation":"utf8mb4_bin"}}
RESTORE_DATABASE_DEFAULTS=
